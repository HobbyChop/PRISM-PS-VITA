+/* Partials a note-on would allocate on this part: the instrument's partial
+ * mask, as the Note constructor reads it. 0 for undefined instruments. */
+int Synth::_note_partials(Part &p, uint8_t key)
+{
+  uint8_t bank = _settings->get_param(PatchParam::ToneNumber, p.id());
+  uint8_t tone = _settings->get_param(PatchParam::ToneNumber2, p.id());
+  uint16_t idx;
+  if (_settings->get_param(PatchParam::UseForRhythm, p.id()) == 0)
+    idx = _ctrlRom.variation(bank)[tone];
+  else
+    idx = _ctrlRom.drumSet(bank).preset[key];
+  if (idx == 0xffff)
+    return 0;
+  uint8_t m = _ctrlRom.instrument(idx).partialsUsed & 3;
+  return (m & 1) + ((m >> 1) & 1);
+}
+
+
+/* Steal one note. Releasing notes give way first, quietest first; otherwise
+ * the oldest sounding note goes, like the hardware's last-note priority.
+ * Returns the partials freed, 0 when there was nothing to steal. */
+int Synth::_steal_one(void)
+{
+  Part *vp = NULL;
+  Note *vn = NULL;
+  long best = 0;
+  for (auto &p : _parts) {
+    long score;
+    Note *n = p.steal_candidate(&score);
+    if (n && (!vn || score < best)) { vn = n; vp = &p; best = score; }
+  }
+  if (!vn)
+    return 0;
+  return vp->kill_note(vn);
+}
